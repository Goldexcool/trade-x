# Paystack sandbox keys: https://dashboard.paystack.com/#/settings/developers (Test mode)
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
# Where Paystack sends the browser after payment. Points at our verify endpoint by default.
# Postgres (Neon). Use sslmode=verify-full for hosted DBs.
DATABASE_URL=postgresql://user:password@host/db?sslmode=verify-full

PAYSTACK_CALLBACK_URL=http://localhost:3000/payments/callback

JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@trade-x.local
ADMIN_PASSWORD=admin12345
RESERVATION_MINUTES=15

# Brevo (transactional email). Leave BREVO_API_KEY empty to log emails instead of sending.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Trade-X
